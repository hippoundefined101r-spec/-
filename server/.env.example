# Порт HTTP-сервера
PORT=8787

# Токен Telegram-бота (из @BotFather). Нужен для проверки initData и контакта.
# В dev можно оставить пустым — проверка initData тогда переходит в мягкий режим.
BOT_TOKEN=

# Источник каталога: mock | bitrix
CATALOG_SOURCE=mock

# Параметры Bitrix (используются при CATALOG_SOURCE=bitrix). Заполнить на этапе 2.
BITRIX_BASE_URL=
BITRIX_WEBHOOK_TOKEN=

# CORS: origin фронтенда (Mini App). Через запятую. * — разрешить все (только для dev).
CORS_ORIGIN=*
