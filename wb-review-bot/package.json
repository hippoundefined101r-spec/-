{
  "name": "wb-review-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram-бот: автоматические ответы на отзывы Wildberries (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply wb_review_bot --local",
    "db:migrate:remote": "wrangler d1 migrations apply wb_review_bot --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "typescript": "^5.5.4",
    "wrangler": "^4.24.0"
  }
}
